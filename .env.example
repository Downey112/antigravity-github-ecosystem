# Antigravity Runtime Settings
ANTIGRAVITY_ENV=production
LOG_LEVEL=INFO
SESSION_SAVE_DIR=./data/sessions
TRIGGER_INTERVAL_SECONDS=3600

# GitHub Integration
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPOSITORY=owner/repository-name
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
# Account covered by the daily checkup; leave empty to use the owner of GITHUB_REPOSITORY
PORTFOLIO_OWNER=

# Google Cloud Run Integration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
CLOUD_RUN_SERVICE_NAME=antigravity-agent-daemon

# LinkGravity Notification & Approvals (Telegram / Discord / Slack)
LINKGRAVITY_PLATFORM=slack # slack, discord, or telegram
LINKGRAVITY_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
LINKGRAVITY_TELEGRAM_BOT_TOKEN=
LINKGRAVITY_TELEGRAM_CHAT_ID=
LINKGRAVITY_DISCORD_WEBHOOK_URL=

# Generic Webhooks (Incident response, SMS, email, custom endpoints)
OUTBOUND_WEBHOOK_URL=https://api.yourdomain.com/webhooks/agent-events
WEBHOOK_SECRET_KEY=your_secret_signing_key
