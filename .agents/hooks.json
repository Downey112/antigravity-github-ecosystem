{
  "safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/safety_check.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "error-telemetry": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/on_tool_error.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "context-injector": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python scripts/pre_turn.py",
        "timeout": 10
      }
    ]
  }
}
